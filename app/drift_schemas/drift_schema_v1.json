      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"space_id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"created_by\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"identity_public_key\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "spaces",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"spaces\" (\"id\" TEXT NOT NULL, \"space_id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"created_by\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"kind\" TEXT NOT NULL, \"root_node_id\" TEXT NULL, \"merged_into_space_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "space_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"space_members\" (\"id\" TEXT NOT NULL, \"space_id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"created_by\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"user_id\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"joined_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"space_id\", \"user_id\"));"
